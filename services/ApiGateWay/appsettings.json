{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "ecomm-identity",
    "Audience": "ecomm-api",
    "Key": "dev-only-secret-change-me-in-production-0123456789"
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "products-read": {
        "ClusterId": "products",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/products/{**catch-all}", "Methods": [ "GET" ] }
      },
      "products-write": {
        "ClusterId": "products",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/products/{**catch-all}", "Methods": [ "POST", "PUT", "PATCH", "DELETE" ] }
      },
      "customers": {
        "ClusterId": "customers",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/customers/{**catch-all}" }
      },
      "orders": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://localhost:5180" } } },
      "products": { "Destinations": { "d1": { "Address": "http://localhost:5165" } } },
      "customers": { "Destinations": { "d1": { "Address": "http://localhost:5157" } } },
      "orders": { "Destinations": { "d1": { "Address": "http://localhost:3100" } } }
    }
  }
}
